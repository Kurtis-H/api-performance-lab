{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-00000000002a",
    "name": "Booking API (api-performance-lab)",
    "description": "End-to-end walk through the booking API with assertions on every step. Run with:\n\nnpx newman run postman/booking.postman_collection.json -e postman/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Browse",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"reports which problems are on\", () => pm.expect(pm.response.json().bugs).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "List events (first page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns at most 5 events\", () => pm.expect(body.items.length).to.be.at.most(5));",
                  "pm.test(\"each event has a seat count\", () => body.items.forEach(e => pm.expect(e.available_seats).to.be.a(\"number\")));",
                  "pm.test(\"query count is reported and small\", () => pm.expect(Number(pm.response.headers.get(\"X-DB-Queries\"))).to.be.at.most(3));",
                  "pm.test(\"responds in under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.collectionVariables.set(\"eventId\", body.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get one event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is the requested event\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"eventId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "Event seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"only available seats by default\", () => pm.response.json().items.forEach(s => pm.expect(s.status).to.eql(\"available\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/seats?limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "seats"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Event stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"sold never exceeds total\", () => pm.expect(s.seats_sold).to.be.at.most(s.seats_total));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "stats"
              ]
            }
          }
        },
        {
          "name": "Unknown event is 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "999999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Buy a seat",
      "item": [
        {
          "name": "Admin creates an event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"newEventId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman test night\",\n  \"venue\": \"Postman hall\",\n  \"starts_at\": \"2027-03-01T19:00:00Z\",\n  \"seats\": 2,\n  \"price_cents\": 3000\n}"
            }
          }
        },
        {
          "name": "Find an available seat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const seats = pm.response.json().items;",
                  "pm.test(\"new event has 2 seats\", () => pm.expect(seats.length).to.eql(2));",
                  "pm.collectionVariables.set(\"seatId\", seats[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{newEventId}}/seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{newEventId}}",
                "seats"
              ]
            }
          }
        },
        {
          "name": "Buy the seat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test(\"charged the seat price\", () => pm.expect(order.total_cents).to.eql(3000));",
                  "pm.collectionVariables.set(\"orderId\", order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{buyerKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat_ids\": [\n    {{seatId}}\n  ]\n}"
            }
          }
        },
        {
          "name": "Same seat again is a 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{otherBuyerKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat_ids\": [\n    {{seatId}}\n  ]\n}"
            }
          }
        },
        {
          "name": "Read my order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"contains the seat\", () => pm.expect(pm.response.json().items[0].seat_id).to.eql(Number(pm.collectionVariables.get(\"seatId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{buyerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Security (OWASP API Top 10)",
      "item": [
        {
          "name": "API1: someone else's order is 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{otherBuyerKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "API2: no API key is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "API3: mass assignment is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{otherBuyerKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat_ids\": [\n    1\n  ],\n  \"total_cents\": 0,\n  \"user_id\": 1\n}"
            }
          }
        },
        {
          "name": "API4: page size is capped",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?limit=100000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100000"
                }
              ]
            }
          }
        },
        {
          "name": "API5: users cannot call admin endpoints",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{otherBuyerKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\",\n  \"venue\": \"y\",\n  \"starts_at\": \"2027-01-01T00:00:00Z\",\n  \"seats\": 1,\n  \"price_cents\": 1\n}"
            }
          }
        }
      ]
    }
